{
  "name": "willys-code-closet",
  "productName": "Willy's Code Closet",
  "private": true,
  "version": "0.0.1",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "workbench": "electron-vite build && electron .",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "marked-highlight": "^2.2.4",
    "node-pty": "^1.1.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.13.6",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14"
  },
  "license": "MIT",
  "description": "Electron + SolidJS wrapper around Claude Code via the Agent SDK: tabs, groups, dev-server and lazygit panes, voice dictation.",
  "repository": {
    "type": "git",
    "url": "https://github.com/guacardo/willys-code-closet"
  }
}
